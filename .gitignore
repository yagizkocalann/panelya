# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.devserver.*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# wrangler local dev secrets (Cloudflare Workers runtime reads these, not
# process.env — see runtime-config.ts's cloudflare:workers fallback)
.dev.vars*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/
/.tools/

# generated build output
/build-output/

# Local recovery exports can contain account and operational data. Never commit
# real backup artifacts; only the verifier and synthetic tests belong in Git.
/.backups/
/recovery-bundles/

# Local image-generation and research binaries. Keep prompt, manifest, QA and
# production notes in Git; keep heavyweight raster sources on local storage.
/artifacts/**/*.png
/artifacts/**/*.jpg
/artifacts/**/*.jpeg
/artifacts/**/*.webp
/artifacts/**/*.gif
/artifacts/**/*.avif

# Public runtime images are committed as optimized WebP. Original PNG/JPEG
# sources remain available locally and can be regenerated with the helper.
/public/images/**/*.png
/public/images/**/*.jpg
/public/images/**/*.jpeg

# Local database files
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# Firebase istemci yapılandırması. Gerçek dosyalar yerel diskte durur ve
# Firebase Console'dan indirilir; CI/release aşamasında encrypted secret
# üzerinden üretilir. Kurulum: docs/mobile-firebase-config.md
/apps/mobile/android/app/google-services.json
/apps/mobile/ios/Runner/GoogleService-Info.plist

# Android release imza yapılandırması. Gerçek keystore ve key.properties
# yalnız yerel diskte veya CI secret deposunda durur, asla commit edilmez;
# release imzası key.properties veya PANELYA_ANDROID_* ortam değişkenlerinden
# fail-closed olarak okunur. Kurulum: apps/mobile/android/app/build.gradle.kts
# ve apps/mobile/README.md "Release build".
/apps/mobile/android/key.properties
/apps/mobile/android/**/*.keystore
/apps/mobile/android/**/*.jks
