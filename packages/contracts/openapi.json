{
  "openapi": "3.1.0",
  "info": {
    "title": "Panelya Public API",
    "version": "1.4.0",
    "description": "Public reading, production authentication and account-lifecycle contracts consumed by the Panelya web and Flutter clients. JSON shapes are defined in schema.json."
  },
  "servers": [
    { "url": "http://localhost:3000", "description": "Local web API" }
  ],
  "paths": {
    "/api/catalog": {
      "get": {
        "operationId": "getCatalog",
        "summary": "List published series",
        "responses": {
          "200": {
            "description": "Published catalog",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/CatalogResponse" }
              }
            }
          }
        }
      }
    },
    "/api/discovery": {
      "get": {
        "operationId": "getDiscovery",
        "summary": "Get editorial home discovery sections",
        "responses": {
          "200": {
            "description": "Featured series, genres, new series and latest published episodes",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/DiscoveryResponse" }
              }
            }
          }
        }
      }
    },
    "/api/series/{slug}": {
      "get": {
        "operationId": "getSeriesDetail",
        "summary": "Get a published series and its episode summaries",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Published series detail",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/SeriesDetailResponse" }
              }
            }
          },
          "404": {
            "description": "Series not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/series/{slug}/episodes/{episodeSlug}": {
      "get": {
        "operationId": "getEpisodeManifest",
        "summary": "Get a published episode reader manifest",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1 }
          },
          {
            "name": "episodeSlug",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Published episode manifest",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/EpisodeManifestResponse" }
              }
            }
          },
          "404": {
            "description": "Episode not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/auth/config": {
      "get": {
        "operationId": "getAuthConfig",
        "summary": "Get public OIDC and native PKCE configuration",
        "responses": {
          "200": {
            "description": "Public Auth0 tenant configuration without secrets",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/AuthProviderConfigResponse" }
              }
            }
          },
          "503": {
            "description": "Production identity provider is not available",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/AuthErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/auth/mobile/token": {
      "post": {
        "operationId": "exchangeOrRefreshMobileToken",
        "summary": "Exchange a native PKCE authorization code or rotate a refresh token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  { "$ref": "./schema.json#/$defs/AuthAuthorizationCodeExchangeRequest" },
                  { "$ref": "./schema.json#/$defs/AuthRefreshTokenRequest" }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Short-lived API access token and rotated refresh token",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/AuthTokenResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid grant, verifier, redirect URI or refresh token reuse",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/AuthErrorResponse" }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/AuthErrorResponse" }
              }
            }
          },
          "503": {
            "description": "Identity provider unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/AuthErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/auth/mobile/revoke": {
      "post": {
        "operationId": "revokeMobileSession",
        "summary": "Revoke the mobile refresh-token grant",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "./schema.json#/$defs/AuthRevokeRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Grant revoked or already inactive",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/AuthLogoutResponse" }
              }
            }
          },
          "503": {
            "description": "Identity provider unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/AuthErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "getAuthState",
        "summary": "Get the current Panelya user for a web cookie or mobile bearer token",
        "security": [
          { "PanelyaAccessToken": [] },
          { "PanelyaWebSession": [] },
          {}
        ],
        "responses": {
          "200": {
            "description": "Authenticated user or anonymous state",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/AuthStateResponse" }
              }
            }
          },
          "401": {
            "description": "Presented credentials expired or were revoked",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/AuthErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/account": {
      "get": {
        "operationId": "getAccountOverview",
        "summary": "Get the current account and server-defined capabilities",
        "security": [
          { "PanelyaAccessToken": [] },
          { "PanelyaWebSession": [] }
        ],
        "responses": {
          "200": {
            "description": "Account overview and provider capabilities",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/AccountOverviewResponse" }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/AccountErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/account/profile": {
      "patch": {
        "operationId": "updateAccountProfile",
        "summary": "Update the current user's editable Panelya profile",
        "security": [
          { "PanelyaAccessToken": [] },
          { "PanelyaWebSession": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "./schema.json#/$defs/AccountProfileUpdateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated account overview",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/AccountOverviewResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid profile update",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/AccountErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/account/password-reset": {
      "post": {
        "operationId": "requestAccountPasswordReset",
        "summary": "Request a provider-hosted password reset email",
        "security": [
          { "PanelyaAccessToken": [] },
          { "PanelyaWebSession": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "./schema.json#/$defs/AccountPasswordResetRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Request accepted without disclosing account existence",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/AccountActionAcceptedResponse" }
              }
            }
          },
          "409": {
            "description": "Password is managed by the external provider",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/AccountErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/account/email-change": {
      "post": {
        "operationId": "requestAccountEmailChange",
        "summary": "Change a database identity email after fresh authentication",
        "security": [
          { "PanelyaAccessToken": [] },
          { "PanelyaWebSession": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "./schema.json#/$defs/AccountEmailChangeRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Email change and verification request accepted",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/AccountActionAcceptedResponse" }
              }
            }
          },
          "409": {
            "description": "Provider-managed email or conflicting address",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/AccountErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/account/reauthentication/start": {
      "post": {
        "operationId": "startAccountReauthentication",
        "summary": "Start purpose-bound fresh Auth0 authentication with PKCE",
        "security": [
          { "PanelyaAccessToken": [] },
          { "PanelyaWebSession": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "./schema.json#/$defs/AccountReauthenticationStartRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Single-use reauthentication request and system-browser URL",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/AccountReauthenticationStartResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid purpose, redirect URI or PKCE challenge",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/AccountErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/account/reauthentication/complete": {
      "post": {
        "operationId": "completeAccountReauthentication",
        "summary": "Exchange and verify the fresh Auth0 callback without replacing the live session",
        "security": [
          { "PanelyaAccessToken": [] },
          { "PanelyaWebSession": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "./schema.json#/$defs/AccountReauthenticationCompleteRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Purpose-bound single-use Panelya reauthentication token",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/AccountReauthenticationCompleteResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid, expired or already consumed callback context",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/AccountErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/account/sessions": {
      "get": {
        "operationId": "listAccountSessions",
        "summary": "List merged web and native sessions",
        "security": [
          { "PanelyaAccessToken": [] },
          { "PanelyaWebSession": [] }
        ],
        "responses": {
          "200": {
            "description": "Public session inventory without credentials or IP addresses",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/AccountSessionsResponse" }
              }
            }
          }
        }
      }
    },
    "/api/account/sessions/{sessionId}": {
      "delete": {
        "operationId": "revokeAccountSession",
        "summary": "Revoke one web or native session",
        "security": [
          { "PanelyaAccessToken": [] },
          { "PanelyaWebSession": [] }
        ],
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        ],
        "responses": {
          "200": {
            "description": "Idempotent revocation result",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/AccountSessionRevocationResponse" }
              }
            }
          },
          "404": {
            "description": "Session not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/AccountErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/account/sessions/revoke": {
      "post": {
        "operationId": "revokeAccountSessions",
        "summary": "Revoke other or all account sessions",
        "security": [
          { "PanelyaAccessToken": [] },
          { "PanelyaWebSession": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "./schema.json#/$defs/AccountSessionRevocationRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Aggregate revocation result",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/AccountSessionRevocationResponse" }
              }
            }
          }
        }
      }
    },
    "/api/account/blocks": {
      "get": {
        "operationId": "listBlockedAccounts",
        "summary": "List accounts blocked by the current user",
        "security": [
          { "PanelyaAccessToken": [] },
          { "PanelyaWebSession": [] }
        ],
        "responses": {
          "200": {
            "description": "Blocked account summaries",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/BlockedAccountsResponse" }
              }
            }
          }
        }
      }
    },
    "/api/account/blocks/{userId}": {
      "put": {
        "operationId": "blockAccount",
        "summary": "Idempotently block an account",
        "security": [
          { "PanelyaAccessToken": [] },
          { "PanelyaWebSession": [] }
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        ],
        "responses": {
          "202": {
            "description": "Block accepted",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/AccountActionAcceptedResponse" }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "unblockAccount",
        "summary": "Idempotently remove an account block",
        "security": [
          { "PanelyaAccessToken": [] },
          { "PanelyaWebSession": [] }
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        ],
        "responses": {
          "200": {
            "description": "Block removed or already absent",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/AccountActionAcceptedResponse" }
              }
            }
          }
        }
      }
    },
    "/api/account/deletion": {
      "get": {
        "operationId": "getAccountDeletionSummary",
        "summary": "Get structured deletion, anonymization and retention effects",
        "security": [
          { "PanelyaAccessToken": [] },
          { "PanelyaWebSession": [] }
        ],
        "responses": {
          "200": {
            "description": "Structured deletion effects for client-side localization",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/AccountDeletionSummaryResponse" }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "deleteAccount",
        "summary": "Start the idempotent account deletion saga",
        "security": [
          { "PanelyaAccessToken": [] },
          { "PanelyaWebSession": [] }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "minLength": 16, "maxLength": 128 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "./schema.json#/$defs/AccountDeletionRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Deletion saga accepted or idempotently resumed",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/AccountDeletionOperationResponse" }
              }
            }
          },
          "409": {
            "description": "Invalid, expired, reused or wrong-purpose reauthentication token",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schema.json#/$defs/AccountErrorResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "PanelyaAccessToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Short-lived Auth0 access token for the Panelya API audience. ID tokens are rejected."
      },
      "PanelyaWebSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "panelya_session",
        "description": "Host-only HttpOnly web session. Mobile clients must not emulate this cookie."
      }
    }
  }
}
