<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="Panelya"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Flutter 3.44'te platform deep link'leri varsayılan olarak
                 açık; bu anahtar niyeti açıkça belgelemek ve gelecekte
                 varsayılan değişse bile davranışı sabitlemek için `true`
                 olarak eklendi (bkz. ios/Runner/Info.plist
                 FlutterDeepLinkingEnabled ile aynı gerekçe). -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="true"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep-link taslağı (bkz. docs/mobile-handoff.md İlk mobil
                 kapsam #5, apps/mobile/README.md "Deep-link"): `panelya://`
                 custom scheme. `autoVerify` YOK — bu yalnız http(s) Android
                 App Links'te domain sahipliğini doğrulamak için kullanılır
                 (assetlinks.json), custom scheme'de karşılığı yok ve
                 sessizce yok sayılır. Production domain kararı verilince
                 ayrı bir `https` intent-filter + `autoVerify="true"`
                 eklenecek (bkz. README "Gelecek adım"). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="panelya"/>
            </intent-filter>
            <!-- App Links (Görev 3, bkz. apps/mobile/README.md "Gelecek adım" ->
                 gerçekleşen durum): ayrı bir `https` intent-filter,
                 `android:autoVerify="true"` ile. Bu, Android'e uygulamanın kurulumu
                 sırasında `https://<host>/.well-known/assetlinks.json`'ı çekip
                 imza SHA-256 parmak izini doğrulamasını (Digital Asset Links)
                 söyler; doğrulama geçerse bu linkler tarayıcıya değil doğrudan
                 uygulamaya gider (kullanıcıya seçici diyaloğu ÇIKMAZ).
                 `android:host` DEĞERİ BU DOSYADA YOK — `${appLinkHost}`
                 `android/app/build.gradle.kts`'teki `manifestPlaceholders`'tan
                 gelir (bkz. o dosyadaki ayrıntılı yorum); production domain
                 kararı verilene kadar gerçek bir değer sağlanmazsa `.invalid`
                 TLD'li anlamsız bir varsayılana düşer, filtre hiçbir gerçek
                 App Link'i eşlemez. `pathPrefix="/"` ile tüm path'ler bu
                 filtreye düşer; ASIL host/path güvenliği (allowlist + web
                 path -> mobil rota eşlemesi) Flutter tarafında
                 `UniversalLinkConfig` + `mapWebPathToMobileRoute` ile sağlanır
                 (bkz. `app/router/router.dart`) — bilinmeyen host veya
                 desteklenmeyen path orada güvenli biçimde keşfe düşer. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="${appLinkHost}"
                    android:pathPrefix="/"/>
            </intent-filter>
        </activity>
        <!-- Auth0 sistem tarayıcı Authorization Code + PKCE geri dönüşü
             (bkz. ADR-039, `flutter_web_auth_2` paket kurulumu). Bu ayrı
             `CallbackActivity`, MainActivity'nin yukarıdaki genel `panelya://`
             filtresiyle (host kısıtı yok, `panelya://series/...` push
             deep-link'lerini yakalar) ÇAKIŞMASIN diye `android:host="auth"`
             ile SADECE `panelya://auth/...`'ü eşler — Android'in intent
             eşleştirmesi daha spesifik (scheme+host) eşleşmeyi tercih
             ettiğinden `panelya://auth/callback` doğrudan buraya, diğer
             `panelya://` linkleri MainActivity'ye gider; kullanıcıya "hangi
             uygulamayla aç" seçici DİYALOĞU çıkmaz. -->
        <activity
            android:name="com.linusu.flutter_web_auth_2.CallbackActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter android:label="flutter_web_auth_2">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="panelya" android:host="auth"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
